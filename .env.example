# ==============================================================================
# SCHOOL ERP BACKEND ENVIRONMENT CONFIGURATION (EXAMPLE TEMPLATE)
# Note: In-memory repository mode is active. No database connection needed.
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME="School ERP Backend API"

# Security & Authentication
JWT_ACCESS_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_JWT_ACCESS_SECRET"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_SECRET="CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS_JWT_REFRESH_SECRET"
JWT_REFRESH_EXPIRATION="7d"

# CORS Configuration
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8080"

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging & Observability
LOG_LEVEL="debug"

# External Integrations (MOCK ADAPTER MODE)
# Set to 'mock' for local in-memory development
PAYMENT_GATEWAY_PROVIDER="mock"
NOTIFICATION_PROVIDER="mock"
DOCUMENT_GENERATOR_PROVIDER="mock"
STORAGE_PROVIDER="mock"
QUEUE_PROVIDER="in-memory"
